import java.util.*;

public class AtaqueVigenere {

    public static byte[] hexToBytes(String hex) {

        byte[] bytes = new byte[hex.length() / 2];

        for (int i = 0; i < bytes.length; i++) {
            bytes[i] = (byte) Integer.parseInt(
                    hex.substring(i * 2, i * 2 + 2),
                    16
            );
        }

        return bytes;
    }

    public static String decifrar(byte[] cifrado, String chave) {

        byte[] resultado = new byte[cifrado.length];

        for (int i = 0; i < cifrado.length; i++) {

            resultado[i] =
                    (byte) (cifrado[i] ^
                    chave.charAt(i % chave.length()));
        }

        return new String(resultado);
    }

    public static void main(String[] args) {

        String cifrado = "COLE_AQUI_O_TEXTO_CIFRADO";

        String chave =
                "ogatomorderaroupadapresidentaderomaedarainharaimunda";

        byte[] bytes = hexToBytes(cifrado);

        String texto = decifrar(bytes, chave);

        System.out.println(texto);
    }
}
